// CI: the local config with resources that fit a GitHub runner.
// Copied to pipeline/nextflow_local_custom.config by the workflow, which the test scripts pick up.
includeConfig 'nextflow_local.config'

// Run as the runner user: the image's default user can't write the work dir (".command.trace: Permission denied")
docker {
    runOptions = '--volume $DATA_PATH:/tmp/data --user $(id -u):$(id -g)'
}

process {
    cpus = 2
    memory = '6 GB'
}
