plugins {
    id 'nf-schema@2.7.3' // validates the parameters file; needs Nextflow >= 25.10
}

process {
  executor = 'awsbatch'
  queueSize = 100

  resourceLabels = ['allen-batch-pipeline': 'aind-ephys-hybrid-benchmark']

  withName: save_provenance {
    cpus = 1
    memory = '2 GB'
  }
  withName: job_dispatch {
    cpus = 4
    memory = '32 GB'
  }
  withName: job_dispatch_hybrid {
    cpus = 4
    memory = '32 GB'
  }
  withName: hybrid_generation {
    cpus = 16
    memory = '64 GB'
  }
  withName: compress_wavpack {
    cpus = 16
    memory = '64 GB'
  }
  withName: preprocessing {
    cpus = 16
    memory = '64 GB'
  }
  withName: spikesort_kilosort4 {
    cpus = 16
    memory = '60 GB'
    accelerator = 1
  }
  withName: spikesort_kilosort25 {
    cpus = 16
    memory = '60 GB'
    accelerator = 1
  }
  withName: spikesort_spykingcircus2 {
    cpus = 16
    memory = '64 GB'
    containerOptions = '--memory-swappiness 20 --shm-size 16g'
  }
  withName: spikesort_lupin {
    cpus = 16
    memory = '64 GB'
    containerOptions = '--memory-swappiness 20 --shm-size 16g'
  }
  withName: spikesort_dartsort {
    cpus = 16
    memory = '60 GB'
    accelerator = 1
  }
  withName: hybrid_evaluation {
    cpus = 16
    memory = '128 GB'
    containerOptions = '--memory-swappiness 20 --shm-size 16g'
  }
}

// Env variables for the pipeline
env.DATA_PATH = 's3://aind-benchmark-data/ephys-hybrid-evaluation/sorters/np1'
params.params_file = 'params_co.json'
