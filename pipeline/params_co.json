            "job_kwargs": {
                "chunk_duration": "1s",
                "progress_bar": false
            },
            "skip_motion_correction": false,
            "min_drift_channels": 96,
            "raise_if_fails": true,
            "sorter": {
                "detect_threshold": 6,
                "projection_threshold": [
                    10,
                    4
                ],
                "preclust_threshold": 8,
                "car": true,
                "minFR": 0.1,
                "minfr_goodchannels": 0.1,
                "nblocks": 5,
                "sig": 20,
                "freq_min": 150,
                "sigmaMask": 30,
                "nPCs": 3,
                "ntbuff": 64,
                "nfilt_factor": 4,
                "NT": null,
                "AUCsplit": 0.9,
                "do_correction": true,
                "wave_length": 61,
                "keep_good_only": false,
                "skip_kilosort_preprocessing": false,
                "scaleproc": null,
                "save_rez_to_mat": false,
                "delete_tmp_files": [
                    "matlab_files"
