{
    "pipeline_version": "1.5.0",
    "benchmark": "sorters",
    "existing": false,
    "sorters": [
        "kilosort4",
        "spykingcircus2"
    ],
    "sorter": "kilosort4",
    "compression_cases": [
        "lossless",
        3,
        2.5,
        2.25
    ],
    "logging": {
        "package": "logging",
        "logging_cfg": {
            "level": "INFO",
            "format": "%(message)s"
        }
    },
    "job_dispatch": {
        "split_segments": true,
        "split_groups": true,
        "debug": false,
        "debug_duration": 30,
        "skip_timestamps_check": false,
        "multi_session": true,
        "min_recording_duration": -1,
        "input": "aind",
        "nwb_files": null,
        "streaming": false,
        "remote_path": null,
        "max_recordings": null,
        "s3_path": null,
        "seed": null
    },
    "hybrid_generation": {
        "min_amp": 50,
        "max_amp": 200,
        "min_depth_percentile": 5,
        "max_depth_percentile": 95,
        "num_units": 10,
        "num_cases": 5,
        "correct_motion": true
    },
    "compression": {
        "bps": null,
        "highpass": false
    },
    "preprocessing": {
        "job_kwargs": {
            "chunk_duration": "1s",
            "progress_bar": false,
            "mp_context": "spawn"
        },
        "filter_type": "highpass",
        "remove_out_channels": true,
        "remove_bad_channels": true,
        "min_preprocessing_duration": 120,
        "max_bad_channel_fraction": 0.5,
        "denoising_strategy": "cmr",
        "default_preprocessing_pipeline": {
            "phase_shift": {
